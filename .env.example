# =====================================================================
#  avr-infra — настройки проекта.  Скопировать в .env и заполнить:
#      cp .env.example .env && chmod 600 .env
#  Пустое значение = берётся значение по умолчанию (указано в комментарии).
#  Секреты (ключи, пароли, токены) в git не попадают — только в .env.
# =====================================================================

# ---------- Компания ----------
# название компании — подставляется в описания тулзов и промпты агентов
COMPANY_NAME=
# часовой пояс для времени в отчётах и журнале звонков (по умолч. UTC)
TIMEZONE=

# ---------- Ultravox (голосовые агенты: два отдельных, RO и RU) ----------
# ключ API Ultravox (секрет)
ULTRAVOX_API_KEY=
# ID агента RO (меню 1, тест 5004)
ULTRAVOX_AGENT_ID=
# ID агента RU (меню 2, тест 5003)
ULTRAVOX_AGENT_ID_RU=
# адрес API Ultravox (по умолч. https://api.ultravox.ai/api)
ULTRAVOX_API_URL=
# лимит запроса к API Ultravox (стенограммы), мс (по умолч. 8000)
ULTRAVOX_TIMEOUT_MS=
# сколько фраз клиента брать из стенограммы в отчёт (по умолч. 4)
TRANSCRIPT_MAX_UTTERANCES=
# ссылка на кабинет Ultravox в панели (по умолч. https://app.ultravox.ai)
PANEL_ULTRAVOX_URL=

# ---------- Публичный вход тулзов (nginx на хосте) ----------
# внешний адрес тулзов, напр. https://avr.example.com:8443
TOOLS_PUBLIC_URL=
# заголовок X-AVR-Key (секрет; тот же, что в /etc/nginx/avr_tool_key)
TOOLS_API_KEY=
# адрес:порт nginx для проверки из панели, напр. 192.0.2.10:8443
TOOLS_CHECK_ADDR=

# ---------- Telegram (отчёты о звонках) ----------
# токен бота (секрет); пусто — отчёты выключены
TELEGRAM_BOT_TOKEN=
# чат/группа для отчётов
TELEGRAM_CHAT_ID=
# лимит отправки в Telegram, мс (по умолч. 10000)
TELEGRAM_TIMEOUT_MS=

# ---------- Номер клиента (по нему агент ищет клиента в биллинге) ----------
# как номер называется в отчётах и промптах (по умолч. Client ID)
CLIENT_ID_LABEL=
# формат номера, регулярное выражение без ^ и $ (по умолч. [0-9]{5} — ровно 5 цифр)
CLIENT_ID_PATTERN=
# формат номера словами, по-английски — для агента (по умолч. exactly 5 digits, from the invoice)
CLIENT_ID_FORMAT=

# ---------- Биллинг (необязательно) ----------
# переходник: whmcs | none (none или пусто — выключено: тулз findByClientId агенту не подключать)
BILLING_PROVIDER=
# шаблон ссылки на клиента в отчёте, {client_id}; пусто — по умолч. переходника (WHMCS: WHMCS_ADMIN_URL/clientssummary.php?userid={client_id})
BILLING_CLIENT_URL=
# --- WHMCS ---
# адрес серверного скрипта биллинга (api_client.php)
WHMCS_CUSTOM_API=
# ключ этого скрипта (секрет)
WHMCS_API_KEY=
# имя action в запросе к скрипту (по умолч. find_by_osmp — как в уже развёрнутых api_client.php)
WHMCS_FIND_ACTION=
# имя параметра с номером клиента в запросе и ответе скрипта (по умолч. osmp_id)
WHMCS_ID_PARAM=
# адрес админки биллинга — для ссылок в отчёте
WHMCS_ADMIN_URL=
# лимит запроса к биллингу, мс (по умолч. 15000)
BILLING_TIMEOUT_MS=

# ---------- Учёт сети (необязательно) ----------
# переходник: netbox | none (none — выключено вместе с диагностикой: тулзы getNetworkData и diagnoseClient агенту не подключать)
NETWORK_SOURCE=
# шаблоны ссылок в отчёте, {ip_id} и {device_id}; пусто — по умолч. переходника (NetBox: /ipam/ip-addresses/{ip_id}/, /dcim/devices/{device_id}/)
NETWORK_IP_URL=
NETWORK_DEVICE_URL=
# --- NetBox ---
# адрес NetBox, напр. http://netbox.local
NETBOX_API_URL=
# токен API (секрет)
NETBOX_API_TOKEN=
# адрес NetBox для ссылок в отчёте (по умолч. = NETBOX_API_URL)
NETBOX_WEB_URL=
# лимит одного запроса к NetBox, мс (по умолч. 5000)
NETBOX_TIMEOUT_MS=

# ---------- Диагностика свитчей по SSH (network-diag) ----------
# учётка на свитчах
NETWORK_USER=
# пароль (секрет)
NETWORK_PASS=
# пароль enable (секрет); пусто — без enable
NETWORK_ENABLE=
# сети управления свитчами через , или ; (по умолч. 198.51.100.0/24)
SWITCH_MGMT_NETS=
# подключение, с (по умолч. 8)
SSH_CONNECT_TIMEOUT=
# одна команда, с (по умолч. 12)
SSH_CMD_TIMEOUT=
# вся диагностика, с (по умолч. 10)
SSH_TOTAL_TIMEOUT=
# сколько faq-server ждёт network-diag, мс: больше SSH_TOTAL_TIMEOUT, меньше таймаута тулза diagnoseClient в Ultravox (по умолч. 12000)
DIAG_TIMEOUT_MS=

# ---------- Asterisk: AMI (служебный доступ; тот же, что в asterisk/conf/manager.conf) ----------
# по умолч. avr-asterisk
AMI_HOST=
# по умолч. 5038
AMI_PORT=
# по умолч. avr — сменить
AMI_USERNAME=
# по умолч. avr — сменить (секрет)
AMI_PASSWORD=

# ---------- Панель управления ----------
# логин (по умолч. admin)
PANEL_USER=
# пароль (секрет, обязателен)
PANEL_PASS=
# интерфейс: 127.0.0.1 — только с хоста (по умолч.), IP сервера — из LAN
PANEL_BIND=
# порт (по умолч. 8090)
PANEL_PORT=
# путь к проекту на хосте, напр. /home/avradmin/avr-infra
PROJECT_DIR=
# часовой пояс расписания панели (по умолч. UTC)
CRON_TZ=
# когда панель проверяет систему и шлёт отчёт в Telegram, формат cron (по умолч. 0 8 * * * — ежедневно 08:00)
HEALTH_REPORT_CRON=
# лимит каждой проверки панели, мс (по умолч. 8000)
HEALTH_TIMEOUT_MS=
