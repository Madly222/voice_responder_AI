# avr-infra: публичный вход для тулзов Ultravox (генерируется install_nginx.sh)
# Внешний <PUBLIC_IP>:__PORT__ (MikroTik dst-nat) -> 192.0.2.10:__PORT__ -> 127.0.0.1:3000

limit_req_zone $binary_remote_addr zone=avr_tools:10m rate=10r/s;

# Секретный ключ: map из отдельного файла (root, 600), в логи не пишется
include /etc/nginx/avr_tool_key.conf;

server {
    listen __PORT__ ssl http2;   # синтаксис nginx 1.18 (Ubuntu 22.04)
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:avr_ssl:5m;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 64k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    access_log /var/log/nginx/avr-tools.access.log;
    error_log  /var/log/nginx/avr-tools.error.log warn;

    # Только тулзы агента. getCalls наружу НЕ отдаётся.
    location ~ ^/tool/(searchFAQ|findByOSMP|getNetworkData|diagnoseClient|updateCall)$ {
        limit_except POST { deny all; }
        if ($avr_key_ok = 0) { return 403; }
        limit_req zone=avr_tools burst=20 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Всё остальное (/health, /sounds, getCalls, startCall/endCall — их зовёт
    # только Asterisk изнутри по http://faq-server:3000, checkRecentCall, сканеры) — закрыть без ответа
    location / { return 444; }
}
