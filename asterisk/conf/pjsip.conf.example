[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0
external_media_address=192.0.2.10
external_signaling_address=192.0.2.10
local_net=172.28.0.0/24
local_net=172.17.0.0/16
local_net=192.0.2.0/24

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0
external_media_address=192.0.2.10
external_signaling_address=192.0.2.10
local_net=172.28.0.0/24
local_net=172.17.0.0/16
local_net=192.0.2.0/24

[1000]
type=endpoint
context=demo
disallow=all
allow=ulaw
allow=alaw
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
auth=1000-auth
aors=1000-aor

[1000-auth]
type=auth
auth_type=userpass
username=1000
password=CHANGE_ME

[1000-aor]
type=aor
max_contacts=5
qualify_frequency=30

[PBX_TRUNK]
type=endpoint
context=demo
disallow=all
allow=ulaw
allow=alaw
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes

[PBX_TRUNK-identify]
type=identify
endpoint=PBX_TRUNK
match=192.0.2.21
match=192.0.2.20
