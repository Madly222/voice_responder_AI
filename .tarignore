# ============================================================
# .tarignore: exclusions for archives sent out for code review
# Usage: tar czf out.tar.gz --exclude-from=.tarignore -C <parent> <projectdir>
# Or use mktar.sh next to this file.
# ============================================================

# --- SECRETS (most important) ---
.env
# IMPORTANT: tar does NOT support negation (!.env.example), so the broad '.env.*'
# pattern is not used: it would drop .env.example too. Real variants are listed explicitly:
.env.local
.env.dev
.env.development
.env.prod
.env.production
.env.staging
.env.test
*.env
.env.bak*
.env.backup*
*.bak-*
# .env.example is NOT excluded: it stays in the archive as the config template.
*.pem
*.key
*.ppk
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.keystore
*.jks
secrets.yaml
secrets.yml
secrets.json
*secret*
*credentials*
.netrc
.npmrc
.pgpass
.htpasswd
service-account*.json
gcp-*.json
*token*.json

# --- DATA / PERSONAL DATA (phone numbers, call logs, dumps) ---
calls.txt
*.sqlite
*.sqlite3
*.db
*.dump
*.sql
data/*.txt
data/*.csv

# --- LOGS AND TEMP FILES ---
*.log
logs/
ngrok.log
tmp/
temp/
*.tmp
*.swp
*.bak
*~

# --- DEPENDENCIES AND BUILDS (not needed for code review) ---
.git
.git/
node_modules
node_modules/
.venv
venv/
env/
__pycache__
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.next/
.cache/

# --- NESTED ARCHIVES (e.g. avr-cleaned.tar.gz) ---
*.tar
*.tar.gz
*.tgz
*.zip
*.gz

# --- EDITOR / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- JUNK FROM BROKEN COMMANDS ---
-d
-H
